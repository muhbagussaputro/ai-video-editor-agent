# Storage paths
VIDEO_DIR=/data/videos
WORK_DIR=/data/work
LOG_DIR=/data/logs
CACHE_DIR=/data/cache

# Runtime
TZ=Asia/Jakarta
COMPOSE_PROJECT_NAME=ai-video-clipper

# LLM provider
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api-model9router.gusaja.com/v1
OPENAI_API_KEY=your_openai_key_here
NINE_ROUTER_API_KEY=your_9router_key_here
GEMINI_API_KEY=your_gemini_key_here

# Transcription / highlight selection
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TRANSCRIPTION_PATH=/audio/transcriptions
TRANSCRIPTION_LANGUAGE=
TARGET_DURATION=30
OUTPUT_RESOLUTION=1080x1920
OUTPUT_FPS=30

# Optional local ASR fallback
LOCAL_TRANSCRIPTION_MODEL=base
LOCAL_TRANSCRIPTION_DEVICE=cpu
LOCAL_TRANSCRIPTION_COMPUTE_TYPE=int8
LOCAL_TRANSCRIPTION_LANGUAGE=
LOCAL_TRANSCRIPTION_BEAM_SIZE=1
TRUST_REMOTE_CODE=false

# Queue / worker tuning
REDIS_URL=redis://redis:6379/0
MAX_CONCURRENCY=1
API_RETRY_COUNT=3
API_RETRY_BACKOFF_SECONDS=5

MIN_HIGHLIGHT_DURATION=8

MAX_HIGHLIGHT_DURATION=0
KEEP_POV_PREFIX=false
